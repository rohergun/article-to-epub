# Copy this file to .env and fill in your values.

# Your Kindle's Send-to-Kindle address
# (Amazon > Manage Your Content and Devices > Preferences > Personal Document Settings)
KINDLE_EMAIL=your-name@kindle.com

# The account that sends the email. Add it to Amazon's
# "Approved Personal Document E-mail List" or Kindle will drop the message.
# Defaults to SMTP_USER if left empty.
SENDER_EMAIL=you@gmail.com

# SMTP settings for the sending account.
# Gmail: smtp.gmail.com, port 465, and an App Password (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
